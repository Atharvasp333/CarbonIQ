# CarbonIQ CLI Configuration

# Backend API Configuration
CARBONIQ_API_URL=http://localhost:8000/api

# CodeCarbon Configuration
CODECARBON_TRACKING_MODE=machine  # Options: machine, process
CODECARBON_OUTPUT_DIR=./measurements
CODECARBON_LOG_LEVEL=info

# Carbon Aware SDK Configuration (optional)
CARBON_AWARE_SDK_URL=http://localhost:5073/emissions/forecasts/current
CARBON_AWARE_SDK_ENABLED=false

# AWS Configuration (if measuring AWS workloads)
AWS_REGION=us-east-1
