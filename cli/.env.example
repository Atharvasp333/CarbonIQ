# CarbonIQ CLI Configuration

# Backend API Configuration
CARBONIQ_API_URL=http://localhost:8000/api

# CodeCarbon Configuration
CODECARBON_TRACKING_MODE=machine  # Options: machine, process
CODECARBON_OUTPUT_DIR=./measurements
CODECARBON_LOG_LEVEL=info

# Electricity Maps API Configuration
ELECTRICITY_MAPS_API_KEY=

# AWS Configuration (if measuring AWS workloads)
AWS_REGION=us-east-1
AWS_BUCKET_NAME=carboniq-bucket
AWS_FILE_PREFIX=carboniq-cur/

# Carbon Aware SDK Configuration
# The SDK provides real-time grid carbon intensity across cloud regions.
# Start locally: docker run -p 5073:80 ghcr.io/green-software-foundation/carbon-aware-sdk:latest
CARBON_AWARE_SDK_URL=http://localhost:5073
CARBON_AWARE_SDK_TIMEOUT=10
