# =============================================================================
# CarbonIQ Configuration - Single Environment File
# Copy this to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=change-me-in-production-use-a-long-random-string
NEON_AUTH_URL=https://your-project.neonauth.region.aws.neon.tech/dbname/auth
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# External API Keys
# -----------------------------------------------------------------------------
CLIMATIQ_API_KEY=                    # Optional - falls back to hardcoded factors
GEMINI_API_KEY=                      # Optional - falls back to generic recommendations
ELECTRICITY_MAPS_API_KEY=            # Required for CLI carbon-aware features

# -----------------------------------------------------------------------------
# AWS Configuration (for CLI and S3 fetching)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FILE_PREFIX=                     # e.g., carboniq-cur/carboniq-cur/data/

# -----------------------------------------------------------------------------
# CLI Configuration
# -----------------------------------------------------------------------------
CARBONIQ_API_URL=http://localhost:8000/api
CODECARBON_TRACKING_MODE=machine     # Options: machine, process
CODECARBON_OUTPUT_DIR=./cli/measurements
CODECARBON_LOG_LEVEL=info
